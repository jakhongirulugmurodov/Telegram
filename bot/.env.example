# BotFather bergan token. Bu faylni .env deb nusxalang va to'ldiring.
# .env hech qachon git'ga tushmaydi.
BOT_TOKEN=

# Sizning Telegram user id'ingiz (raqam). Faqat shu odam boshqara oladi.
# Bilmasangiz: botni ishga tushiring, unga yozing, logda id ko'rinadi.
ADMIN_ID=

# Mini app ochiq turadigan https manzil. Masalan:
# PUBLIC_URL=https://qorgon.onagy-task.duckdns.org
PUBLIC_URL=

PORT=8080
DB_PATH=/app/data/qorgon.db
